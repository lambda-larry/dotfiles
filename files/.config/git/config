[init]
	defaultBranch = master
[commit]
	verbose = true
[alias]
	gr = log \
		--all \
		--decorate \
		--graph \
		--abbrev-commit \
		--format=format:'%C(yellow)%h%C(reset)%C(auto)%d%C(reset) %C(normal)%s%C(reset) %C(blue)[author: %an]%C(reset) %C(dim green)[%cI @%ct]%C(reset)'
	ggr = log \
		--all \
		--decorate \
		--graph \
		--abbrev-commit \
		--format=format:'%G? %C(yellow)%h%C(reset)%C(auto)%d%C(reset) %C(normal)%s%C(reset) %C(blue)[author: %an]%C(reset) %C(dim green)[%cI @%ct]%C(reset)'
[core]
	pager = less -F
[checkout]
	workers = 0
[log]
	date = iso
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers

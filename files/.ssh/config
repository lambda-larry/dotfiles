Include ~/.ssh/ssh_config

Host *
	UserKnownHostsFile ~/.ssh/known_hosts ~/.ssh/known_hosts.d/%h

Host github.com
	ControlMaster auto
	ControlPath /run/user/%i/ssh-%h
	Controlpersist 300

Host git.sr.ht
	ControlMaster auto
	ControlPath /run/user/%i/ssh-%h
	Controlpersist 300

Host codeberg.org
	ControlMaster auto
	ControlPath /run/user/%i/ssh-%h
	Controlpersist 300
